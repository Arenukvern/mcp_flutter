# Regenerate: vhs docs/assets/gifs/cli-exec.tape
Output docs/assets/gifs/cli-exec.gif

Require bash
Set Shell "bash"
Set FontSize 15
Set Width 960
Set Height 540
Set Padding 24
Set Theme "GitHub Dark"
Set PlaybackSpeed 2.0
Set MarginFill "#0d1117"

Type "bash docs/assets/gifs/scenarios/exec_demo.sh"
Enter
Sleep 32s