# MCP Registry image build. This is intentionally separate from the legacy
# Dockerfiles so existing `docker build .` users keep their current contract.
# Build from the repository root:
# docker build -f mcp_server_dart/Dockerfile.registry -t flutter-mcp-toolkit:registry .
#
# The build is STANDALONE: production resolves hosted pub.dev siblings and
# drops `resolution: workspace`. The monorepo workspace would drag in Flutter-app
# members (harness, showcase) whose universal_automation_interface floor
# conflicts with the SDK meta pin of older Flutter images.
#
# PR smoke CI (`mcp_registry_dockerfile.yml`) may inject sibling packages plus an
# ephemeral `mcp_server_dart/pubspec_overrides.yaml` in a temp build context when
# a release-please PR bumps train versions before pub.dev publish. Production
# publish (`publish_mcp_registry.yml`) never supplies overrides — only hosted.
#
# ghcr.io/cirruslabs/flutter stopped updating after Flutter 3.44.0 (Dart 3.12.0).
# CI trains on Flutter 3.47.5 (Dart 3.13.4); the build stage installs that
# stable linux SDK from storage.googleapis.com. Values must match
# tool/contracts/flutter_sdk_pin.env (reproducibility anchor).
FROM debian:bookworm-slim AS build

ARG FLUTTER_VERSION=3.47.5
ARG FLUTTER_SDK_SHA256=2132e990f236f8d22e7c6314b29a191a95b10d7cbcfec9b4e2e303d996652cbb

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl git unzip xz-utils && \
    rm -rf /var/lib/apt/lists/* && \
  curl -fsSL "https://storage.googleapis.com/flutter_infra_release/releases/stable/linux/flutter_linux_${FLUTTER_VERSION}-stable.tar.xz" \
    -o /tmp/flutter.tar.xz && \
  echo "${FLUTTER_SDK_SHA256}  /tmp/flutter.tar.xz" | sha256sum --check --strict - && \
  tar --no-same-owner -xJf /tmp/flutter.tar.xz -C /opt && \
  rm /tmp/flutter.tar.xz && \
  git config --global --add safe.directory /opt/flutter && \
  /opt/flutter/bin/flutter config --no-analytics && \
  /opt/flutter/bin/flutter --version

ENV PATH="/opt/flutter/bin:/opt/flutter/bin/cache/dart-sdk/bin:${PATH}"

WORKDIR /app

COPY mcp_server_dart/ mcp_server_dart/
# Sibling packages are always present in the repo-root build context and in the
# smoke fallback temp context; they are inert unless pubspec_overrides.yaml exists.
COPY packages/core/ packages/core/
COPY packages/server_capability_kernel/ packages/server_capability_kernel/
COPY packages/server_capability_core/ packages/server_capability_core/

# Standalone resolution: drop the workspace marker, then resolve hosted unless
# smoke CI attached pubspec_overrides.yaml (no host lockfile — SDK-bundled pins
# differ per platform, so --enforce-lockfile fails on amd64 CI runners).
RUN cd mcp_server_dart && \
    sed -i '/^resolution: workspace/d' pubspec.yaml && \
    if [ -f pubspec_overrides.yaml ]; then \
      echo "mcp_registry_docker: resolution=workspace_fallback (local sibling path overrides)"; \
    else \
      echo "mcp_registry_docker: resolution=hosted (pub.dev)"; \
    fi && \
    flutter pub get

RUN cd mcp_server_dart && dart compile exe bin/flutter_mcp_toolkit_server.dart -o /app/mcp_server

FROM debian:bookworm-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates tini && \
    rm -rf /var/lib/apt/lists/* && \
    apt-get clean

RUN useradd -r -u 1001 -g root mcpuser

WORKDIR /app
COPY --from=build --chown=mcpuser:root /app/mcp_server /app/mcp_server
USER mcpuser

ENTRYPOINT ["/usr/bin/tini", "--", "/app/mcp_server"]

# Required by the MCP Registry. Additional OCI labels describe the server's
# semantic snapshots, built-in tools, and runtime client-tool registry.
LABEL io.modelcontextprotocol.server.name="io.github.Arenukvern/flutter-mcp-toolkit" \
      org.opencontainers.image.title="Flutter MCP Toolkit" \
      org.opencontainers.image.description="Flutter MCP server with semantic snapshots, ready-to-use interaction tools, and runtime-registered client tools and resources."

CMD ["--resources", "--images", "--log-level=error", "--environment=production"]
