# MCP Registry image build. This is intentionally separate from the legacy
# Dockerfiles so existing `docker build .` users keep their current contract.
# Build from the repository root:
# docker build -f mcp_server_dart/Dockerfile.registry -t flutter-mcp-toolkit:registry .
#
# The build stage uses a Flutter SDK image and the full monorepo context
# because mcp_server_dart depends on workspace siblings (packages/*,
# mcp_toolkit) that are not published to pub.dev, and intentcall_platform
# requires the Flutter SDK. Workspace resolution needs those sources.
# Digest of ghcr.io/cirruslabs/flutter:latest at the 6.0.0 release
# (sha256:217a3d8…, Flutter stable 3.47.x). Cirruslabs stopped publishing
# exact version tags after 3.44.x, and 3.44.x ships a flutter_test that
# pins meta 1.18.0 — conflicting with universal_automation_interface
# 0.2.0 (meta ^1.19.0) in the workspace. The digest is the reproducibility
# anchor; bump it deliberately per release.
FROM ghcr.io/cirruslabs/flutter@sha256:217a3d81b124f3fab82b24633bf66b256cc74528b894e7f17103f70150232077 AS build

WORKDIR /app

COPY pubspec.yaml VERSION ./
COPY mcp_server_dart/pubspec.yaml mcp_server_dart/pubspec.yaml
COPY mcp_toolkit/ mcp_toolkit/
COPY packages/ packages/
# Workspace members: pub resolution requires every directory listed in
# the root workspace, even ones the server image never compiles.
COPY showcase/drivers/ showcase/drivers/
COPY jaspr_web_example/ jaspr_web_example/
COPY mcp_server_dart/bin/ mcp_server_dart/bin/
COPY mcp_server_dart/lib/ mcp_server_dart/lib/
COPY mcp_server_dart/analysis_options.yaml mcp_server_dart/analysis_options.yaml

# Resolve inside the pinned image rather than enforcing a host-generated
# lockfile: Flutter SDK-bundled package pins differ between host platforms
# (arm64 vs amd64), so --enforce-lockfile fails on the amd64 CI runner.
# The pinned base-image tag is the reproducibility anchor.
RUN cd mcp_server_dart && flutter pub get

RUN cd mcp_server_dart && dart compile exe bin/flutter_mcp_toolkit_server.dart -o /app/mcp_server

FROM debian:bookworm-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates tini && \
    rm -rf /var/lib/apt/lists/* && \
    apt-get clean

RUN useradd -r -u 1001 -g root mcpuser

WORKDIR /app
COPY --from=build --chown=mcpuser:root /app/mcp_server /app/mcp_server
USER mcpuser

ENTRYPOINT ["/usr/bin/tini", "--", "/app/mcp_server"]

# Required by the MCP Registry. Additional OCI labels describe the server's
# semantic snapshots, built-in tools, and runtime client-tool registry.
LABEL io.modelcontextprotocol.server.name="io.github.Arenukvern/flutter-mcp-toolkit" \
      org.opencontainers.image.title="Flutter MCP Toolkit" \
      org.opencontainers.image.description="Flutter MCP server with semantic snapshots, ready-to-use interaction tools, and runtime-registered client tools and resources."

CMD ["--resources", "--images", "--log-level=error", "--environment=production"]
